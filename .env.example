# Server Configuration
PORT=3000
HOST=0.0.0.0
MCP_TS_LOG_LEVEL=INFO
MCP_TS_CONFIG_PATH=
MCP_TS_CACHE_ENABLED=true
MCP_TS_MAX_FILE_SIZE_MB=10

# MCP Endpoint Authentication (audit finding SEC-02)
# Enable Bearer auth on /api/mcp and /mcp/sse.
# Default: true when NODE_ENV=production, false otherwise. Must be "true" or "false".
MCP_AUTH_ENABLED=
# Comma-separated static API keys accepted as Bearer tokens (e.g. key1,key2,key3).
MCP_API_KEYS=
# Secret for HS256 JWT validation (minimum 32 characters, RFC 7518 section 3.2).
# Optional; when set, JWTs signed with this secret are also accepted.
MCP_JWT_SECRET=

# Workspace root boundary for /api/scan-directory (audit finding SEC-03)
# Comma-separated directory roots the scan endpoint may access (absolute or
# cwd-relative, e.g. /workspace,/projects,./src). Default: /workspace.
# Malformed values (empty list, null bytes) abort startup.
MCP_ALLOWED_WORKSPACE_ROOTS=

# CORS origin allowlist (audit finding SEC-04)
# Comma-separated allowed origins (e.g. https://example.com,https://app.example.com).
# Default: http://localhost:3000. Malformed values abort startup.
MCP_CORS_ORIGINS=
# Explicit opt-in required before a wildcard (*) is accepted in MCP_CORS_ORIGINS.
# Must be "true" or "false". Default: false. In wildcard mode credentials are
# disabled (credentialed wildcard responses are forbidden by the Fetch spec).
MCP_CORS_ALLOW_WILDCARD=
